# Slack Bot Token (https://api.slack.com/apps/ から取得)
# get_token() が読むのは SLACK_TOKEN → SLACK_BOT_TOKEN の順。
# SLACK_USER_TOKEN (xoxp-) はコードから参照していないので不要。
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# merge_legs.py の Slack 通知先 (Incoming Webhook)
# 未設定だとマージの中断・ロールバックが通知されず、失敗に気づけない
MERGE_LEGS_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ
